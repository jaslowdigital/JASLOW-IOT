# JASLOW IOT — Cloud Functions settings. For a manual deploy, copy to functions/.env (never commit it).
# The GitHub deploy workflow writes functions/.env itself from repo Variables/Secrets (see SETUP.md).

PUBLIC_ORIGIN=https://jaslowiot.com
COMPANY_PHONE=
# Firebase project number (= VITE_FIREBASE_MESSAGING_SENDER_ID); used to name the service account to share Sheets with.
GCP_PROJECT_NUMBER=
# Or set the service account directly:
# GCP_SERVICE_ACCOUNT=

# Inventory feed (empty = inventory sync is off)
DMS_API_BASE=
PHOTO_BASE=
DEFAULT_IMAGE_BASE=

# Optional
# BACKUP_BUCKET=jaslow-iot-backups
# GOOGLE_PLACES_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WEBHOOK_BASE=
# TURNSTILE_SECRET=
# ENABLE_AI_WRITER=true      (also needs the ANTHROPIC_API_KEY secret in Secret Manager)
# WH_REALTIME=true
