# JASLOW IOT — web app settings. Copy to frontend/.env (never commit .env) and fill in.
# In GitHub Actions the same values come from repo Variables (see SETUP.md).

# --- Firebase web app (Firebase console → Project settings → Your apps → Web app → SDK config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jaslow-iot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jaslow-iot
VITE_FIREBASE_STORAGE_BUCKET=jaslow-iot.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Site and company ---
VITE_PUBLIC_ORIGIN=https://jaslowiot.com
VITE_COMPANY_NAME=Jaslow IoT
# Main customer phone shown on public pages; leave empty to hide it.
VITE_COMPANY_PHONE=
VITE_COMPANY_WEBSITE=https://jaslowiot.com
VITE_SUPPORT_EMAIL=support@jaslowdigital.com
# Optional: defaults to <messaging sender id>-compute@developer.gserviceaccount.com
VITE_GCP_SERVICE_ACCOUNT=

# --- Inventory feed and photos (leave empty until a DMS is connected) ---
VITE_DMS_API_BASE=
VITE_PHOTO_BASE=
VITE_WINDOW_STICKER_BASE=
VITE_DEFAULT_IMAGE_BASE=
# Your deployed mp-assistant/photo-worker, e.g. https://jaslow-photos.<you>.workers.dev
VITE_PHOTO_WORKER_URL=

# --- Optional one-time import from an older standalone MP Assistant project ---
VITE_LEGACY_PROJECT_ID=
VITE_LEGACY_API_KEY=
